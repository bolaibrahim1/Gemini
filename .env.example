# API
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform?schema=public

# Redis (queues, cache)
REDIS_URL=redis://localhost:6379
# Run the BullMQ flow worker inside the API process (requires Redis)
WORKER_ENABLED=true

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Email (MailHog in local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@platform.local

# AI (plan §6.7) — 'mock' runs fully offline; 'gemini' needs an API key
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
